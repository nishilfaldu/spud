{
	"name": "spud",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.4",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"test": "bun test packages apps",
		"check": "bun run typecheck && bun run lint && bun run test"
	},
	"dependencies": {
		"@spud/cli": "workspace:*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@types/bun": "1.4.4",
		"typescript": "7.0.2"
	}
}
